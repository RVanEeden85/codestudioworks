# Canonical public URL
NEXT_PUBLIC_SITE_URL=https://www.codestudioworks.com

# Enquiry storage
MONGODB_URI=
MONGODB_DB=codestudioworks

# Transactional email
POSTMARK_API_KEY=
POSTMARK_FROM_EMAIL=
POSTMARK_TO_EMAIL=
POSTMARK_REPLY_TO_EMAIL=
POSTMARK_MESSAGE_STREAM=outbound

# Form abuse protection. Create a Managed Turnstile widget in Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=codestudioworks.com,www.codestudioworks.com

# Used to hash request identifiers before durable rate-limit storage.
FORM_SECURITY_SECRET=

# Private admin access. Use long, unique values for both.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
